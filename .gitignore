# Generated submission archives; keep the directory itself.
artifacts/submissions/*
!artifacts/submissions/.gitkeep

# Potentially large/generated match data; keep the documented layout.
data/analysis/*
!data/analysis/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/models/*
!data/models/.gitkeep
data/replays/*
!data/replays/.gitkeep
data/runs/*
!data/runs/.gitkeep
data/submissions/*
!data/submissions/.gitkeep
data/summaries/*
!data/summaries/.gitkeep
data/training/*
!data/training/.gitkeep

# Generated experiment datasets, compressed replays, and packaged snapshots.
# Keep these local (or publish them as release/object-storage artifacts), not in Git.
*.npy
*.gz
*.zip

# Large reproducible V126 evaluation traces; keep compact summaries tracked.
experiments/research_20260920_v126/known_case_replays/
experiments/research_20260920_v126/four_arm_development/replays/
experiments/research_20260920_v126/four_arm_development/decision_log.jsonl

# Large reproducible learning-next arrays, replays, and temporary package roots.
experiments/learning_next_20260921/datasets/**/*.npy
experiments/learning_next_20260921/package_staging/
experiments/learning_next_20260921/*_evaluation/replays/
